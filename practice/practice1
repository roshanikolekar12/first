D)))Kubernetes Deployment Configuration:
1) Create a file named :     php-apache-dep.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: php-apache-deployment
spec:
  replicas: 5  # Requirement 2: Launch 5 pods
  selector:
    matchLabels:
      app: php-apache
  template:
    metadata:
      labels:
        app: php-apache
    spec:
      containers:
      - name: php-apache-container # Requirement 3: Container name
        image: php:apache            # Requirement 1: Pull PHP with Apache
        ports:
        - containerPort: 80         # Requirement 4: Container port 80
---
apiVersion: v1
kind: Service
metadata:
  name: php-apache-service
spec:
  type: NodePort
  selector:
    app: php-apache
  ports:
    - protocol: TCP
      port: 8080      # Requirement 4: Port 8080 on localhost (mapping)
      targetPort: 80

