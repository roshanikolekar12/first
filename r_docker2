Docker Compose: Nginx Static Website
1) Set up the Folder and HTML file:
mkdir website
echo "<h1>Hello from Docker Compose</h1>" > website/index.html
2)Create the Docker Compose File:          docker-compose.yml 
services:
  web-server:
    image: nginx:latest
    ports:
      - "8080:80"
    volumes:
      - ./website:/usr/share/nginx/html
3)Launch with Docker Compose:  docker compose up -d
4)to check status of service:  docker compose ps
5)Browser:                     http://localhost:8080
6)To stop and remove:          docker compose down


Docker Compose: Python Script Container
1)Create the Python Script: app.py
print("Hello from Python Container")
2) Create Dockerfile: 
FROM python:3.9-slim
WORKDIR /app
COPY app.py .
CMD ["python", "app.py"]
3)Create the Docker Compose File: docker-compose.yml
services:
  python-app:
    build: .
4)Run the Container: docker compose up


Docker Compose: MySQL with Volume
1)Create the Docker Compose File:
services:
  db:
    image: mysql:latest
    environment:
      MYSQL_ROOT_PASSWORD: my-secret-pw
      MYSQL_DATABASE: my_database
    volumes:
      - mysql_storage:/var/lib/mysql

volumes:
  mysql_storage:
2) Start the Container: docker compose up -d
3)Create Table and Insert Data:
docker exec -it $(docker compose ps -q db) mysql -u root -p
SQL:
USE my_database;
CREATE TABLE test (id INT AUTO_INCREMENT PRIMARY KEY, val VARCHAR(20));
INSERT INTO test (val) VALUES ('Persistence Test');
SELECT * FROM test;
EXIT;
4)Restart the Container:     docker compose restart db
5)Verify Data Still Exists:
docker exec -it $(docker compose ps -q db) mysql -u root -p -e "SELECT * FROM my_database.test;"


Docker Compose: One Volume with 3 Nginx Containers:
1)Create the Docker Compose File:
services:
  nginx1:
    image: nginx:latest
    ports:
      - "8081:80"
    volumes:
      - shared-data:/usr/share/nginx/html
    # Creates a 'c1' folder and tells Nginx to use it as the root
    command: /bin/sh -c "mkdir -p /usr/share/nginx/html/c1 && echo '<h1>Hello from Container 1</h1>' > /usr/share/nginx/html/c1/index.html && sed -i 's|/usr/share/nginx/html|/usr/share/nginx/html/c1|g' /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"

  nginx2:
    image: nginx:latest
    ports:
      - "8082:80"
    volumes:
      - shared-data:/usr/share/nginx/html
    # Creates a 'c2' folder and tells Nginx to use it as the root
    command: /bin/sh -c "mkdir -p /usr/share/nginx/html/c2 && echo '<h1>Hello from Container 2</h1>' > /usr/share/nginx/html/c2/index.html && sed -i 's|/usr/share/nginx/html|/usr/share/nginx/html/c2|g' /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"

  nginx3:
    image: nginx:latest
    ports:
      - "8083:80"
    volumes:
      - shared-data:/usr/share/nginx/html
    # Creates a 'c3' folder and tells Nginx to use it as the root
    command: /bin/sh -c "mkdir -p /usr/share/nginx/html/c3 && echo '<h1>Hello from Container 3</h1>' > /usr/share/nginx/html/c3/index.html && sed -i 's|/usr/share/nginx/html|/usr/share/nginx/html/c3|g' /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"

volumes:
  shared-data:
2) start the container: docker compose up -d
3)On browser:
http://localhost:8081 
http://localhost:8082
http://localhost:8083

